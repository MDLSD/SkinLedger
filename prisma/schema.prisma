generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Enum-значения храним строками (SQLite не поддерживает enum),
// допустимые значения контролируются zod-схемами на сервере.
// Currency: RUB | USD | EUR | CNY
// DealStatus: holding | sold

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  baseCurrency String   @default("RUB") @map("base_currency")
  // Личная цель по чистой прибыли за месяц (в основной валюте). null — не задана.
  monthlyGoal  Decimal? @map("monthly_goal")
  createdAt    DateTime @default(now()) @map("created_at")
  // Рубеж действительности сессий: JWT, выданные раньше этого момента,
  // считаются отозванными. Даёт «выйти на всех устройствах» без
  // серверного хранилища сессий (смена пароля двигает рубеж).
  sessionsValidFrom DateTime @default(now()) @map("sessions_valid_from")

  deals         Deal[]
  platforms     Platform[]
  priceProfiles PriceProfile[]
  watchItems    WatchItem[]

  @@map("users")
}

// Списки пользователя по предметам: избранное и чёрный список (ТЗ 3.1,
// колонка «Избранное / +»). Одна строка на пару (пользователь, предмет):
// предмет не может быть одновременно избранным и скрытым.
model WatchItem {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  // Мягкая ссылка на каталог, как и в котировках: список переживает предмет,
  // который временно пропал из выгрузки.
  marketHashName String   @map("market_hash_name")
  kind           String // "favorite" | "blocked"
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketHashName])
  @@index([userId, kind])
  @@map("watch_items")
}

// Шаблон настроек таблицы цен: сохранённый набор параметров (площадки, тип
// цены, диапазоны) под своим именем, напр. «lis → tm».
model PriceProfile {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  // Строка параметров таблицы целиком, как в адресе: ?buy=lis_skins&sell=…
  query     String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("price_profiles")
}

// Заявки с лендинга («Планируется»): дешёвая проверка спроса на фичи.
model Lead {
  id        String   @id @default(uuid())
  email     String
  feature   String? // какая планируемая фича интересует
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("leads")
}

model Platform {
  id                String  @id @default(uuid())
  name              String
  defaultSellFeePct Decimal @default(0) @map("default_sell_fee_pct")
  defaultBuyFeePct  Decimal @default(0) @map("default_buy_fee_pct")
  isCustom          Boolean @default(false) @map("is_custom")
  userId            String? @map("user_id")

  user      User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  buyDeals  Deal[] @relation("BuyPlatform")
  sellDeals Deal[] @relation("SellPlatform")

  @@map("platforms")
}

model Deal {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  itemName    String  @map("item_name")
  itemQuality String? @map("item_quality")
  quantity    Int     @default(1)

  buyPlatformId String   @map("buy_platform_id")
  buyPrice      Decimal  @map("buy_price")
  buyCurrency   String   @default("RUB") @map("buy_currency")
  buyFxRate     Decimal  @default(1) @map("buy_fx_rate")
  buyFeePct     Decimal  @default(0) @map("buy_fee_pct")
  buyDate       DateTime @map("buy_date")

  status String @default("holding")

  sellPlatformId String?   @map("sell_platform_id")
  sellPrice      Decimal?  @map("sell_price")
  sellCurrency   String?   @map("sell_currency")
  sellFxRate     Decimal?  @map("sell_fx_rate")
  sellFeePct     Decimal?  @map("sell_fee_pct")
  sellDate       DateTime? @map("sell_date")

  note String?

  // Ссылка на предмет из каталога (скин/стикер). Nullable: старые сделки
  // со свободным текстом остаются без ссылки.
  itemId String? @map("item_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  buyPlatform  Platform    @relation("BuyPlatform", fields: [buyPlatformId], references: [id])
  sellPlatform Platform?   @relation("SellPlatform", fields: [sellPlatformId], references: [id])
  item         MarketItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, buyDate])
  @@index([userId, sellDate])
  @@map("deals")
}

// Каталог торгуемых предметов CS2 (источник: ByMykel/CSGO-API).
// Одна запись = один торгуемый вариант с уникальным market_hash_name.
// kind разделяет виды: "skin" (оружие+скин+износ+ST/SV) и "sticker" (стикер+финиш).
model MarketItem {
  id String @id @default(uuid())

  kind String @default("skin") // "skin" | "sticker"

  // Идентификаторы из источника для идемпотентного импорта.
  externalId String @unique @map("external_id") // id варианта, напр. skin-..._3 / sticker-1247
  familyId   String @map("family_id") // id семейства (варианты одного предмета)

  // --- Скины ---
  weapon   String? // базовое оружие: AK-47, AWP, Karambit …
  skinName String? @map("skin_name") // название скина (pattern); null у ванильных ножей
  wear     String? // Factory New … Battle-Scarred; null если без износа
  stattrak Boolean @default(false)
  souvenir Boolean @default(false)
  star     Boolean @default(false) // ★ у ножей/перчаток

  // --- Стикеры ---
  stickerName String? @map("sticker_name") // «s1mple | MLG Columbus 2016»
  finish      String? // Paper / Holo / Foil / Gold / Glitter / Lenticular / Embroidered
  stickerType String? @map("sticker_type") // Autograph / Team / Event / Other
  tournament  String? // турнир/событие

  // Полное имя в формате Steam (уникально), напр.
  // StatTrak™ AWP | Dragon Lore (Field-Tested) / Sticker | s1mple (Foil) | MLG Columbus 2016.
  marketHashName String @unique @map("market_hash_name")

  // ЧПУ для публичной страницы предмета (ТЗ 7.2): генерируется один раз при
  // создании записи и больше не меняется — иначе ломаются проиндексированные
  // ссылки. Уникален; при коллизии получает числовой суффикс.
  slug String @unique

  // Для страниц-хабов и хлебных крошек (ТЗ 2.2). Заполняются из каталожного
  // датасета; если предмета там нет — остаются null.
  collection String? // «The Phoenix Collection»
  rarity     String? // «Classified», «Covert» …

  // Картинка предмета (CDN Steam) — для превью в автокомплите.
  image String?

  // Русские алиасы для поиска.
  ruWeapon   String? @map("ru_weapon")
  ruSkinName String? @map("ru_skin_name")

  deals Deal[]

  @@index([kind])
  @@index([familyId])
  @@index([familyId, wear, stattrak, souvenir]) // резолв скина
  @@index([familyId, finish]) // резолв стикера
  @@map("market_items")
}

// ── Модуль сравнения цен (этап 2) ──────────────────────────────────────────
// Ценовые данные живут отдельно от Platform (та — комиссии для ручного ввода
// сделок). Источник — внешний агрегатор (Pricempire), качается кроном в БД.
// Цены хранятся нормализованными в USD; в валюту пользователя — на отображении.

// Площадка-источник цен + наши комиссии (агрегатор их не отдаёт, заполняем сами).
model MarketSource {
  slug           String  @id // ключ провайдера: steam, buff163, market_csgo …
  title          String
  currency       String  @default("USD") // родная валюта площадки (справочно)
  buyFeePct      Decimal @default(0) @map("buy_fee_pct")
  sellFeePct     Decimal @default(0) @map("sell_fee_pct")
  withdrawFeePct Decimal @default(0) @map("withdraw_fee_pct")
  isActive       Boolean @default(true) @map("is_active")

  quotes  PriceQuote[]
  history PriceHistory[]

  @@map("market_sources")
}

// Последний срез цены: ровно одна строка на пару (предмет, площадка).
// Перезаписывается на каждом тике крона. market_hash_name — мягкая ссылка на
// каталог MarketItem (без FK: цены могут прийти для предмета вне каталога).
model PriceQuote {
  marketHashName String   @map("market_hash_name")
  sourceSlug     String   @map("source_slug")
  priceMin       Decimal? @map("price_min") // минимальный листинг, USD
  priceOrder     Decimal? @map("price_order") // ордер покупки (авто-бай), USD
  priceAvg30     Decimal? @map("price_avg_30")
  priceMedian30  Decimal? @map("price_median_30")
  offersCount    Int?     @map("offers_count")
  sales30d       Int?     @map("sales_30d")
  fetchedAt      DateTime @map("fetched_at")

  source MarketSource @relation(fields: [sourceSlug], references: [slug], onDelete: Cascade)

  @@id([marketHashName, sourceSlug])
  @@index([sourceSlug])
  @@index([marketHashName])
  @@map("price_quotes")
}

// История цен для графика. Растёт быстро — чистить/агрегировать по времени.
model PriceHistory {
  id             String   @id @default(uuid())
  marketHashName String   @map("market_hash_name")
  sourceSlug     String   @map("source_slug")
  price          Decimal // нормализовано в USD
  ts             DateTime

  source MarketSource @relation(fields: [sourceSlug], references: [slug], onDelete: Cascade)

  @@index([marketHashName, sourceSlug, ts])
  @@map("price_history")
}
