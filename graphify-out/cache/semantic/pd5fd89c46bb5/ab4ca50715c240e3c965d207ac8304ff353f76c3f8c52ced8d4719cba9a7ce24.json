{"nodes": [{"id": "_claude_skills_verify_skill_verify", "label": "verify skill (drive SkinLedger end-to-end over HTTP)", "file_type": "document", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:1-6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Codifies the build/launch/drive loop so changes are verified against a real running Next.js + NextAuth + Prisma/SQLite stack rather than unit tests alone."}, {"id": "_claude_skills_verify_skill_build_launch", "label": "Build and launch on port 3789", "file_type": "concept", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:8-15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm run build (Turbopack) doubles as a typecheck; a non-default port 3789 avoids colliding with the developer's own :3000 server."}, {"id": "_claude_skills_verify_skill_secure_cookies_gotcha", "label": "Login only works on the dev server (useSecureCookies)", "file_type": "rationale", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:17-22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In a prod build src/auth.ts enables useSecureCookies, so over plain http://localhost the session cookie is never stored and the form misleadingly reports 'wrong email or password'. Anything requiring auth must therefore be driven through `npm run dev -- -p 3789`."}, {"id": "_claude_skills_verify_skill_test_user", "label": "Test user test@example.com / password123", "file_type": "concept", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:20-26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "May be missing from the DB; recreate by upserting user with passwordHash = bcrypt.hash(\"password123\", 10). The script must live at the project root because `tsx -e` cannot do top-level await."}, {"id": "_claude_skills_verify_skill_sqlite_db", "label": "SQLite dev DB at prisma/dev.db", "file_type": "concept", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:24-26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DATABASE_URL=\"file:./prisma/dev.db\" is resolved relative to the repo root, so commands must be run from there; migrate via prisma migrate dev and seed platforms via prisma db seed."}, {"id": "_claude_skills_verify_skill_playwright", "label": "Playwright driving (preferred for dialogs/client code)", "file_type": "concept", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:28-34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything living in dialogs or client-side JS cannot be reached with curl, so Playwright (devDependency + chromium) is the default driver; scripts such as e2e-catalog.mjs run from the project root."}, {"id": "_claude_skills_verify_skill_e2e_catalog_script", "label": ".claude/skills/verify/e2e-catalog.mjs", "file_type": "code", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:33", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_verify_skill_import_catalog", "label": "Catalog import (ByMykel/CSGO-API + ru localization)", "file_type": "concept", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:36-39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downloads skins_not_grouped + stickers from ByMykel/CSGO-API plus Russian localization from counter-strike-file-tracker, and upserts by market_hash_name so the ~30k-item import is idempotent and re-runnable. Offline debugging is possible by feeding SKINS_JSON/STICKERS_JSON/EN_LANG_JSON/RU_LANG_JSON to scripts/import-catalog.ts."}, {"id": "_claude_skills_verify_skill_autocomplete_selectors", "label": "Catalog autocomplete selectors and variant controls", "file_type": "concept", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:40-41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skins expose #wear plus StatTrak/Souvenir checkboxes while stickers expose #finish, so the driving script must branch on item kind after picking from [role=combobox]."}, {"id": "_claude_skills_verify_skill_skins_api_index", "label": "GET /api/skins catalog index (gzip, ~460KB)", "file_type": "concept", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Served pre-gzipped because the full index is ~460KB; the browser decompresses transparently, so no client-side unzip step is needed."}, {"id": "_claude_skills_verify_skill_marketitem_model", "label": "prisma.marketItem model (kind: skin|sticker)", "file_type": "code", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One polymorphic item table discriminated by `kind` instead of separate skin/sticker tables; deals reference it via Deal.itemId."}, {"id": "_claude_skills_verify_skill_dialog_scoping_gotcha", "label": "Gotcha: scope selectors to [data-slot=dialog-content]", "file_type": "rationale", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:46-48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unscoped `form button[type=submit]` also matches the header logout button (it is inside a form too). Related traps: ru-RU money formatting uses NBSP so text must be normalized before comparison, and server actions invoked from JS (useActionState in a dialog) have no form in the SSR HTML, so reversing the Next-Action flight protocol is a waste of time."}, {"id": "_claude_skills_verify_skill_server_actions_curl", "label": "Driving server actions with curl (progressive enhancement)", "file_type": "concept", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:50-63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forms rendered by useActionState degrade to plain POSTs, so hidden $ACTION_1:0 / $ACTION_KEY fields can be scraped from the page HTML and replayed with curl. Success is a redirect chain ending at /app (200); unauthenticated GET /app returns 307 to /login."}, {"id": "_claude_skills_verify_skill_action_id_gotchas", "label": "Gotchas: action IDs change per build", "file_type": "rationale", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:65-72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Argument-free forms (logout in the /app header) render a single $ACTION_ID_<hash> input instead. Action IDs are rebuilt on every build, so they must be re-extracted; 'Failed to find Server Action' in the log means a stale id. Action errors come back embedded in the HTML (grep the Russian text) and [auth][error] lines appear in the server's background output file."}, {"id": "_claude_skills_verify_skill_direct_db_inspection", "label": "Direct DB inspection via tsx + PrismaBetterSqlite3", "file_type": "concept", "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:74-84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses the generated client at ./src/generated/prisma/client with an explicit PrismaBetterSqlite3 driver adapter fed from DATABASE_URL, matching Prisma's adapter-based configuration."}], "edges": [{"source": "readme_dev_server", "target": "_claude_skills_verify_skill_build_launch", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/verify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_verify_skill_verify", "target": "_claude_skills_verify_skill_build_launch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:8", "weight": 1.0}, {"source": "_claude_skills_verify_skill_build_launch", "target": "_claude_skills_verify_skill_secure_cookies_gotcha", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:17-19", "weight": 1.0}, {"source": "_claude_skills_verify_skill_secure_cookies_gotcha", "target": "_claude_skills_verify_skill_test_user", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:20-22", "weight": 1.0}, {"source": "_claude_skills_verify_skill_test_user", "target": "_claude_skills_verify_skill_sqlite_db", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:20-26", "weight": 1.0}, {"source": "_claude_skills_verify_skill_direct_db_inspection", "target": "_claude_skills_verify_skill_sqlite_db", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:74-84", "weight": 1.0}, {"source": "_claude_skills_verify_skill_verify", "target": "_claude_skills_verify_skill_playwright", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:28", "weight": 1.0}, {"source": "_claude_skills_verify_skill_playwright", "target": "_claude_skills_verify_skill_e2e_catalog_script", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:33", "weight": 1.0}, {"source": "_claude_skills_verify_skill_e2e_catalog_script", "target": "_claude_skills_verify_skill_autocomplete_selectors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:33-41", "weight": 1.0}, {"source": "_claude_skills_verify_skill_e2e_catalog_script", "target": "_claude_skills_verify_skill_import_catalog", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:33-39", "weight": 1.0}, {"source": "_claude_skills_verify_skill_import_catalog", "target": "_claude_skills_verify_skill_marketitem_model", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:36-43", "weight": 1.0}, {"source": "_claude_skills_verify_skill_skins_api_index", "target": "_claude_skills_verify_skill_marketitem_model", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:42-43", "weight": 1.0}, {"source": "_claude_skills_verify_skill_autocomplete_selectors", "target": "_claude_skills_verify_skill_skins_api_index", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/verify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_verify_skill_import_catalog", "target": "deploy_import_catalog", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/skills/verify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_verify_skill_verify", "target": "_claude_skills_verify_skill_server_actions_curl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:50", "weight": 1.0}, {"source": "_claude_skills_verify_skill_server_actions_curl", "target": "_claude_skills_verify_skill_action_id_gotchas", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:65-72", "weight": 1.0}, {"source": "_claude_skills_verify_skill_server_actions_curl", "target": "_claude_skills_verify_skill_playwright", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/verify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_verify_skill_dialog_scoping_gotcha", "target": "_claude_skills_verify_skill_server_actions_curl", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".claude/skills/verify/SKILL.md:48-52", "weight": 1.0}, {"source": "_claude_skills_verify_skill_dialog_scoping_gotcha", "target": "_claude_skills_verify_skill_playwright", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/verify/SKILL.md", "source_location": ".